{
  "name": "compaki-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "contract:client": "cd ../.. && stellar scaffold build --network testnet && cp packages/clients/marketplace/src/index.ts apps/api/src/lib/stellar/generated/marketplace.ts",
    "contract:client:check": "tsx scripts/check-contract-client.ts",
    "demo:rewards": "tsx scripts/demo-rewards.ts",
    "data:reset": "tsx scripts/reset-data.ts",
    "stellar:home-domain": "tsx scripts/set-home-domain.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "test:community": "node --import tsx --test src/lib/community.test.ts",
    "test:sep10": "node --import tsx --test src/lib/sep10.test.ts",
    "test:session": "node --import tsx --test src/lib/session.test.ts",
    "test": "node --import tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-sdk": "^16.0.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "hono": "^4.6.14",
    "prisma": "^6.19.3",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.4"
  }
}
