# Copy to apps/web/.env.local and fill in.

# Cavos email sign-in + user-owned Stellar wallets (https://docs.cavos.xyz).
# The app id is public. In the Cavos console add your web origin
# (e.g. http://localhost:3000) under Settings → allowed origins.
NEXT_PUBLIC_CAVOS_APP_ID=
# "development" (default) or "production" — must match the Cavos environment.
NEXT_PUBLIC_CAVOS_ENV=development

# Where the web app proxies /api (default http://localhost:4000).
API_URL=http://localhost:4000
